# Copy to deploy/canary/.env (git-ignored) and fill in.
# Image tags are git SHAs pushed by CI: ghcr.io/zeinabmahfouz/the-egyptian-civil-code-rag:<sha>
STABLE_IMAGE=ghcr.io/zeinabmahfouz/the-egyptian-civil-code-rag:REPLACE_WITH_STABLE_SHA
CANARY_IMAGE=ghcr.io/zeinabmahfouz/the-egyptian-civil-code-rag:REPLACE_WITH_CANARY_SHA
STABLE_RELEASE=stable-REPLACE_WITH_STABLE_SHA
CANARY_RELEASE=canary-REPLACE_WITH_CANARY_SHA

# Rollout stage -- see README "Canary rollout". Weights are relative, and
# nginx rejects 0: to take the canary out of rotation set CANARY_STATE=down.
STABLE_WEIGHT=95
CANARY_WEIGHT=5
CANARY_STATE=
