# Environment variables, names only. Copy to .env (git-ignored) to set any.
#
# NONE are needed to run the project: `docker compose up -d` works with no
# keys and no accounts. Every variable below is optional, and leaving it
# empty keeps the default shown in the comment.

# --- Generation ---------------------------------------------------------------
# OpenAI-compatible vLLM server, e.g. http://localhost:8000/v1.
# Empty: the local CPU model (Qwen3-1.7B, transformers) answers instead.
VLLM_BASE_URL=
# Model name served by vLLM, e.g. Qwen/Qwen3-8B-AWQ. Empty: Qwen/Qwen3-1.7B.
GEN_MODEL=

# --- Retrieval ----------------------------------------------------------------
# Qdrant server, e.g. http://localhost:6333 (docker-compose.qdrant.yml sets it).
# Empty: the embedded index baked into the image (data/processed/qdrant_storage).
QDRANT_URL=

# --- Tracing (Langfuse, self-hosted) -------------------------------------------
# Tracing is off unless both keys are set; nothing else changes.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# e.g. http://localhost:3000
LANGFUSE_BASE_URL=

# --- Monitoring and releases ---------------------------------------------------
# Release label in the X-App-Release header and traces. Empty: dev.
APP_RELEASE=
# RAGAS report exported as the faithfulness gauge.
# Empty: reports/ragas_results.json. The alert demo points it at deploy/monitoring/demo/.
RAGAS_REPORT=

# --- Not needed to run the project ---------------------------------------------
# CI only (GitHub Actions secrets): GDRIVE_SA_JSON reads the DVC remote.
# Hugging Face models are public: no HF token needed (an "unauthenticated
# requests" warning on first download is harmless).
